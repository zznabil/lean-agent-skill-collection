            "from": "queued",
            "action": "build",
            "to": "built"
          },
          {
            "from": "built",
            "action": "stage",
            "to": "staged"
          }
        ],
        "model_transitions": [
          {
            "from": "queued",
            "action": "build",
            "to": "built"
          },
          {
            "from": "built",
            "action": "stage",
            "to": "staged"
          }
        ],
        "model_terminal": true,
        "real_artifact": {
          "deployment.ready": false
        },
        "objective": {
          "target": "deployment.ready",
          "equals": true
        },
        "safe_probe": "read_deployment_status"
      },
      "good_trace": [
